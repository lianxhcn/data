. * 四个手工交互变量
. gen byte ttt = province * group * post

. gen byte pt  = province * post

. gen byte gt  = group * post

. gen byte pg  = province * group

. label var ttt "三重交互 P*G*T"

. label var pt  "省份 × 后期 P*T"

. label var gt  "组别 × 后期 G*T"

. label var pg  "省份 × 组别 P*G"

