. * ------------------------------------------------------------
. * 3. 提取各年系数与标准误，导出供绘图
. * ------------------------------------------------------------
. tempname pf

. postfile `pf' int year double b se using "`root'/data/event_ddd.dta", replace

. forvalues k = 1/8 {
  2.     if `k' == 4 {
  3.         post `pf' (`k') (0) (.)
  4.     }
  5.     else {
  6.         scalar bk = _b[`k'.year#1.province#1.group]
  7.         scalar sk = _se[`k'.year#1.province#1.group]
  8.         post `pf' (`k') (bk) (sk)
  9.     }
 10. }

. postclose `pf'

. 
. preserve

. use "`root'/data/event_ddd.dta", clear

. export delimited using "`root'/data/event_ddd.csv", replace
