> 29855f\01_event_study.do 

. *==============================================================
. * 01_event_study.do
. * 第 2 篇第一类失效：差分平行趋势被破坏
. * 结构：2 省 × 2 组 × 6 年，每格 800 人，共 19 200 个观测
. * 政策在第 3 年后实施：year 1-3 为政策前，4-6 为政策后
. * 场景 A：差分平行趋势成立；场景 B：试点省 B 组存在与政策无关的线性趋势
. * 场景 B 的额外趋势为每年 0.10
. *==============================================================
. 
. clear all

. set more off

. set seed 202

. 
. * 首次运行：请把下一行改为本文件夹 (02-三类诊断) 的完整路径 (用正斜杠)
. local root "D:/doubao_project/blog-lianxh/三重差分系列/02-三类诊断"

. 
. capture mkdir "`root'/data"

. tempname pf

. postfile `pf' str4 scen int year double ddd se using "`root'/data/event_resul
> ts.dta", replace

. 
. foreach scen in good bad {
  2. 
.     * ------------------------------------------------------------
.     * 1. 生成数据：3 200 个个体，各追踪 6 年
.     *    前 1 600 人属非试点省，后 1 600 人属试点省
.     *    每省前 800 人为 A 组，后 800 人为 B 组
.     * ------------------------------------------------------------
.     clear
  3.     set obs 3200
  4.     gen byte province = (_n > 1600)
  5.     gen byte group    = (mod(_n-1, 1600) >= 800)
  6.     gen long id       = _n
  7.     expand 6
  8.     bysort id: gen year = _n
  9.     gen byte post = (year >= 4)
 10. 
.     * ------------------------------------------------------------
.     * 2. 结果变量
.     *    共同时间趋势：每年 +0.10
.     *    共同冲击：试点省政策后 +0.30，对 A、B 两组相同
.     *    政策效应：试点省 B 组政策后 +0.10
.     *    场景 B 另加：试点省 B 组每年 +0.10 的额外趋势，政策前即存在
.     * ------------------------------------------------------------
.     gen double y = 1.0 + 0.20*province + 0.30*group + 0.10*(year-1) ///
>                  + 0.30*province*post + 0.10*province*group*post      ///
>                  + rnormal(0, 0.35)
 11. 
.     if "`scen'" == "bad" {
 12.         replace y = y + 0.10*(year-1)*province*group
 13.     }
 14. 
.     * ------------------------------------------------------------
.     * 3. 手工计算各年 DDD 事件研究系数
.     *    DDD_k = (试点省 B - 试点省 A) - (非试点省 B - 非试点省 A)
.     *    以政策前最后一年 (year 3) 为基准做归一化
.     * ------------------------------------------------------------
.     forvalues k = 1/6 {
 15.         sum y if province==1 & group==1 & year==`k', meanonly
 16.         scalar pb`k' = r(mean)
 17.         sum y if province==0 & group==1 & year==`k', meanonly
 18.         scalar nb`k' = r(mean)
 19.         sum y if province==1 & group==0 & year==`k', meanonly
 20.         scalar pa`k' = r(mean)
 21.         sum y if province==0 & group==0 & year==`k', meanonly
 22.         scalar na`k' = r(mean)
 23.         scalar ddd`k' = (pb`k'-pa`k') - (nb`k'-na`k')
 24.     }
 25. 
.     forvalues k = 1/6 {
 26.         scalar dddn`k' = ddd`k' - ddd3
 27.     }
 28. 
.     display _newline "===== 场景 (`scen')：手工计算的归一化 DDD 事件研究系数 
> ====="
 29.     forvalues k = 1/6 {
 30.         display "year " `k' "  DDD = " %8.4f dddn`k'
 31.     }
 32. 
.     * ------------------------------------------------------------
.     * 4. 饱和回归事件研究：以第 3 年为基准年
.     *    三向交互系数即归一化 DDD 系数，与手工计算对照
.     * ------------------------------------------------------------
.     reg y ib3.year##i.province##i.group, vce(robust) noheader
 33. 
.     display _newline "===== 场景 (`scen')：回归三向交互系数与手工计算对照 ===
> =="
 34.     forvalues k = 1/6 {
 35.         if `k' == 3 {
 36.             scalar bk = 0
 37.             scalar sk = 0
 38.         }
 39.         else {
 40.             scalar bk = _b[`k'.year#1.province#1.group]
 41.             scalar sk = _se[`k'.year#1.province#1.group]
 42.         }
 43.         display "year " `k' "  回归 = " %8.4f bk "  手工 = " %8.4f dddn`k'
>  ///
>                 "  标准误 = " %7.4f sk
 44.         post `pf' ("`scen'") (`k') (dddn`k') (sk)
 45.     }
 46. }
