. * ------------------------------------------------------------
. * 7. 导出结果供绘图
. * ------------------------------------------------------------
. clear

. set obs 2
Number of observations (_N) was 0, now 2.

. gen str12 method = cond(_n==1, "朴素 DDD", "基线分组 DDD")

. gen double ddd  = cond(_n==1, ddd_naive_reg, ddd_base_reg)

. gen double se   = cond(_n==1, se_naive, se_base)

