. *--------------------------------------------------------------
. * B. 平行趋势被破坏：试点省 B 组另有 0.20 的趋势差异
. *    DDD 的真值变为 0.10，但估计出的值是 0.10 + 0.20 = 0.30
. *--------------------------------------------------------------
. tempfile mc_b

. postfile pf2 n rep ddb dda ddd using "`mc_b'", replace
(file C:\Users\admin36\AppData\Local\Temp\ST_15aa8_000002.tmp not found)

. 
. foreach n in 1250 10000 {
  2.     forvalues rep = 1/200 {
  3.         quietly {
  4.             clear
  5.             set obs 8
  6.             gen byte province = (_n >= 5)
  7.             gen byte group    = inlist(_n, 3, 4, 7, 8)
  8.             gen byte post     = inlist(_n, 2, 4, 6, 8)
  9.             expand `n'
 10. 
.             local sd = `n' * 1000 + `rep' + 77
 11.             set seed `sd'
 12.             * 试点省 × B 组 × 后期 的额外趋势 (0.20) 不是政策效应
.             gen double y = 1.0 + 0.20*province + 0.30*group + 0.50*post ///
>                          + 0.30*province*post + 0.10*province*group*post ///
>                          + 0.20*province*group*post ///
>                          + rnormal(0, 0.35)
 13. 
.             gen byte ttt = province * group * post
 14.             gen byte pt  = province * post
 15.             gen byte gt  = group * post
 16.             gen byte pg  = province * group
 17. 
.             reg y ttt pt gt pg i.province i.group i.post, robust
 18.         }
 19.         post pf2 (`n') (`rep') (_b[pt] + _b[ttt]) (_b[pt]) (_b[ttt])
 20.     }
 21. }

. postclose pf2

. 
. use "`mc_b'", clear

. display _n(20) "平行趋势被破坏时（真值 0.10，额外趋势 0.20）"




















