. *==============================================================
. * 01_sample_size.do
. * 两个练习：
. *   A. 样本量放大能收紧标准误，但收不紧偏误
. *   B. 识别假设被破坏时，DDD 的偏误不随样本量缩小
. * 运行：stata /e do 01_sample_size.do
. *==============================================================
. 
. clear all

. set more off

. 
. * 首次运行：请把下一行改为本文件夹 (01-三种用法) 的完整路径 (用正斜杠)
. local root "D:/doubao_project/blog-lianxh/三重差分系列/01-三种用法"

. 
. *--------------------------------------------------------------
. * A. 平行趋势成立时的样本量敏感性
. *--------------------------------------------------------------
. tempfile mc_a

. postfile pf n rep ddb dda ddd se_ddd using "`mc_a'", replace
(file C:\Users\admin36\AppData\Local\Temp\ST_15aa8_000001.tmp not found)

. 
. foreach n in 100 500 1250 10000 {
  2.     forvalues rep = 1/200 {
  3.         quietly {
  4.             clear
  5.             set obs 8
  6.             gen byte province = (_n >= 5)
  7.             gen byte group    = inlist(_n, 3, 4, 7, 8)
  8.             gen byte post     = inlist(_n, 2, 4, 6, 8)
  9.             expand `n'
 10. 
.             local sd = `n' * 1000 + `rep'
 11.             set seed `sd'
 12.             gen double y = 1.0 + 0.20*province + 0.30*group + 0.50*post //
> /
>                          + 0.30*province*post + 0.10*province*group*post ///
>                          + rnormal(0, 0.35)
 13. 
.             gen byte ttt = province * group * post
 14.             gen byte pt  = province * post
 15.             gen byte gt  = group * post
 16.             gen byte pg  = province * group
 17. 
.             reg y ttt pt gt pg i.province i.group i.post, robust
 18.         }
 19.         post pf (`n') (`rep') (_b[pt] + _b[ttt]) (_b[pt]) (_b[ttt]) (_se[t
> tt])
 20.     }
 21. }

. postclose pf

. 
. use "`mc_a'", clear

. label var n   "每格观测数"

. label var ddb "DD_B 的估计"

. label var dda "DD_A 的估计"

. label var ddd "DDD 的估计"

. label var se_ddd "DDD 的标准误"

. table n, statistic(mean ddb) statistic(mean dda) statistic(mean ddd) ///
