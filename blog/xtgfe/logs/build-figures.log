. *=======================================================================
. * File checks and timing
. *=======================================================================
. 
. capture program drop report_file_size

. program define report_file_size
  1.     args path
  2.     confirm file "`path'"
  3.     tempname handle
  4.     file open `handle' using "`path'", read binary
  5.     file seek `handle' eof
  6.     file seek `handle' query
  7.     local bytes = r(loc)
  8.     file close `handle'
  9.     display as text "file bytes: " as result `bytes' ///
>         as text " | `path'"
 10. end

. 
. forvalues figure = 1/5 {
  2.     if `figure' == 1 {
  3.         local filename "xtgfe-fig01-twfe-groups.png"
  4.     }
  5.     else if `figure' == 2 {
  6.         local filename "xtgfe-fig02-bias-ladder.png"
  7.     }
  8.     else if `figure' == 3 {
  9.         local filename "xtgfe-fig03-bic-groups.png"
 10.     }
 11.     else if `figure' == 4 {
 12.         local filename "xtgfe-fig04-g4-alpha.png"
 13.     }
 14.     else {
 15.         local filename "xtgfe-fig05-g4-democracy-means.png"
 16.     }
 17.     report_file_size "`figs'/`filename'"
 18. }
